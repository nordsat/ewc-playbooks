# vim: set filetype=systemd.jinja:
[Unit]
Description=Dispatcher for FM
After=network-online.target

[Container]
Image={{ docker_repo }}dispatcher:main
Pull=never
ContainerName=dispatcher-fm-fci
Network=pytroll.network
# Standard Volumes
Volume={{ install_dir }}/config_fci_nc/dispatcher_config.yaml:/dispatcher/dispatcher_config.yaml:z
Volume={{ output_dir }}:/mnt/output/:z
{# Volume={{ install_dir }}/local/:/.local/:z #}

User=0
DNSSearch={{ dns_domain }}

[Service]
Restart=always

[Install]
WantedBy=default.target
