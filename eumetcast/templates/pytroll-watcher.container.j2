# vim: set filetype=systemd.jinja:
# This file is managed by ansible, do not edit it by hand.
[Unit]
Description=Pytroll Watcher Service for {{ watcher.description }} data
Wants=network-online.target
After=network-online.target

[Container]
Image={{ docker_repo }}{{ watcher_image }}
Pull=never
ContainerName=pytroll-watcher-{{ watcher.name }}
Network=pytroll.network
Volume={{ install_dir }}/{{ watcher.config_dir }}/:/config/:z
Volume=/eumetcast/:/eumetcast/:z
UserNS=keep-id
PublishPort={{ watcher.port }}:{{ watcher.port }}
{% if dns_domain %}
DNSSearch={{ dns_domain }}
{% endif %}

[Service]
Restart=always

[Install]
WantedBy=default.target
