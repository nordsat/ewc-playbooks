# vim: set filetype=systemd.jinja:
# This file is managed by ansible, do not edit it by hand.
[Unit]
Description=Pytroll Watcher Service for FCI data
Wants=network-online.target
After=network-online.target

[Container]
Image={{ docker_repo }}{{ watcher_image }}
Pull=never
ContainerName=pytroll-watcher-fci
Network=pytroll.network
Volume={{ install_dir }}/config_fci_watcher/:/config/:z
Volume=/eumetcast/:/eumetcast/:z
UserNS=keep-id
PublishPort={{ watcher_port }}:{{ watcher_port }}
{% if dns_domain %}
DNSSearch={{ dns_domain }}
{% endif %}

[Service]
Restart=always

[Install]
WantedBy=default.target
