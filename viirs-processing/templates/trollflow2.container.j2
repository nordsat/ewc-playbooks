# vim: set filetype=systemd.jinja:
# This file is managed by ansible, do not edit it by hand.
[Unit]
Description=Trollflow2 Service for VIIRS
After=network-online.target

[Container]
Image={{ docker_repo }}{{ trollflow2_image }}
Pull=never
ContainerName=trollflow2-viirs
Network=pytroll.network
Volume={{ install_dir }}/config_viirs_h5/:/config/:z
Volume={{ output_dir }}:/mnt/output/:z
Volume={{ install_dir }}/local/:/.local/:z
# The input files are read over ssh from the EUMETCast host
Volume={{ ansible_user_dir }}/.ssh/:/root/.ssh:ro
Environment=GDAL_NUM_THREADS=ALL_CPUS
Environment=NUM_THREADS=ALL_CPUS
User=0
DNSSearch={{ dns_domain }}

[Service]
Restart=always

[Install]
WantedBy=default.target
