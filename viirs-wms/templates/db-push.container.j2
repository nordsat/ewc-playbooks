# vim: set filetype=systemd.jinja:
# This file is managed by ansible, do not edit it by hand.
[Unit]
Description=db-push Service for VIIRS
After=network-online.target

[Container]
Image={{ docker_repo }}{{ db_push_image }}
Pull=missing
ContainerName=db-push-viirs
Network=pytroll.network
Volume={{ output_dir }}:/mnt/output/:z
Volume={{ install_dir }}/config/config_viirs_h5/trollflow2.yaml:/etc/trollflow2.yaml:z
Volume={{ install_dir }}/db-push.yaml:/config/db-push.yaml:z
Secret=pgpassword,type=env,target=PGPASSWORD
User=0
DNSSearch={{ dns_domain }}

[Service]
Restart=always

[Install]
WantedBy=default.target
